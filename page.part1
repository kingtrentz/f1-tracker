<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="robots" content="noindex">
<title>__TITLE__ | Redline F1 Tracker</title>
<meta name="description" content="Unofficial fan-made F1 season tracker: next race countdown, standings, title math, results and teammate battles.">
<script>try{var t=localStorage.getItem("rl-theme");if(t)document.documentElement.setAttribute("data-theme",t);}catch(e){}</script>
<link rel="icon" type="image/svg+xml" href="logo.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style>
/* Redline: black header band, red for the things that matter, white or near-black ground underneath. */
:root{
  --bg:#ffffff;--panel:#f6f4f4;--panel-2:#ece8e8;--line:#e4dfdf;--line-strong:#cfc8c8;
  --ink:#0c0c0d;--muted:#5d585a;--faint:#8c8688;
  --red:#d9142b;--red-ink:#b30f23;--red-soft:#fdebed;--red-line:#f3c3c9;--on-red:#ffffff;
  --band:#0c0c0d;--band-2:#18181b;--band-ink:#f4f1f1;--band-muted:#a8a2a4;--band-line:#2c2c31;
  --up:#16824a;--up-soft:#e2f3e9;--up-line:#bfe3cc;--down:#c2410c;--down-soft:#fdeee5;--down-line:#f4cdb5;
  --live:#d9142b;--gold:#b88a00;
  --f-display:"Chakra Petch","Segoe UI",system-ui,sans-serif;
  --f-body:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,"SF Mono",Menlo,Consolas,monospace;
  color-scheme:light;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0a0a0b;--panel:#141416;--panel-2:#1c1c1f;--line:#26262a;--line-strong:#3a3a40;
  --ink:#f2eeee;--muted:#aaa3a5;--faint:#777174;
  --red:#ff2a44;--red-ink:#ff5a6c;--red-soft:#2a0c11;--red-line:#5c1822;--on-red:#ffffff;
  --band:#000000;--band-2:#121214;--band-ink:#f4f1f1;--band-muted:#9d979a;--band-line:#26262b;
  --up:#45c27f;--up-soft:#0f2519;--up-line:#1f4a33;--down:#ff8a4c;--down-soft:#2a160b;--down-line:#5a3218;
  --live:#ff2a44;--gold:#e7b93a;color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0a0a0b;--panel:#141416;--panel-2:#1c1c1f;--line:#26262a;--line-strong:#3a3a40;
  --ink:#f2eeee;--muted:#aaa3a5;--faint:#777174;
  --red:#ff2a44;--red-ink:#ff5a6c;--red-soft:#2a0c11;--red-line:#5c1822;--on-red:#ffffff;
  --band:#000000;--band-2:#121214;--band-ink:#f4f1f1;--band-muted:#9d979a;--band-line:#26262b;
  --up:#45c27f;--up-soft:#0f2519;--up-line:#1f4a33;--down:#ff8a4c;--down-soft:#2a160b;--down-line:#5a3218;
  --live:#ff2a44;--gold:#e7b93a;color-scheme:dark}
*{box-sizing:border-box}
html,body{background:var(--bg);color:var(--ink)}
body{margin:0;font-family:var(--f-body);font-size:15px;line-height:1.45;-webkit-text-size-adjust:100%}
.wrap{max-width:820px;margin:0 auto;padding-block:16px 32px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:flex;flex-direction:column;gap:20px}
h1,h2,h3{font-family:var(--f-display);font-weight:600;margin:0;letter-spacing:.01em;text-wrap:balance}
h2{font-size:18px}
.num{font-variant-numeric:tabular-nums}
.mono{font-family:var(--f-mono)}
.label{font-family:var(--f-mono);font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);font-weight:500}
.note{font-size:12.5px;color:var(--muted)}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:2px solid var(--red);outline-offset:2px}

/* ===== header band ===== */
.band{background:var(--band);color:var(--band-ink);border-bottom:3px solid var(--red);padding-top:env(safe-area-inset-top,0px)}
.band header{max-width:820px;margin:0 auto;padding:12px max(16px,env(safe-area-inset-right,0px)) 10px max(16px,env(safe-area-inset-left,0px));display:flex;flex-direction:column;gap:3px}
.hdr{display:flex;align-items:center;justify-content:space-between;gap:10px;min-width:0}
.brand{display:flex;align-items:center;gap:10px;min-width:0;flex:1 1 auto}
.brand > div{min-width:0}
.logo{width:38px;height:38px;flex:none;display:block}
.eyebrow{font-family:var(--f-mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--band-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.eyebrow b{color:var(--red);font-weight:600}
h1{font-size:23px;line-height:1.05;font-weight:700;letter-spacing:.03em;text-transform:uppercase}
h1 span{color:var(--red)}
.cd{flex:none;display:flex;flex-direction:column;align-items:flex-end;gap:1px;text-align:right}
.cd .label{font-size:9.5px;letter-spacing:.1em;color:var(--red);font-weight:600}
.cd b{font-family:var(--f-mono);font-size:20px;font-weight:600;font-variant-numeric:tabular-nums;line-height:1.1;color:var(--band-ink)}
.cd small{font-family:var(--f-mono);font-size:9.5px;color:var(--band-muted)}
.cd.live .label::before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--red);margin-right:5px;vertical-align:1px;animation:ping 1.6s infinite}
.upd{display:flex;flex-wrap:wrap;align-items:center;gap:2px 14px;font-family:var(--f-mono);font-size:11px;color:var(--band-muted);margin-top:2px}
.upd b{color:var(--band-ink);font-weight:600}
.upd span:first-child::before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--red);margin-right:6px;vertical-align:1px;animation:ping 2.4s infinite}
@keyframes ping{0%{box-shadow:0 0 0 0 rgba(217,20,43,.55)}70%{box-shadow:0 0 0 7px rgba(217,20,43,0)}100%{box-shadow:0 0 0 0 rgba(217,20,43,0)}}
.stat-line{font-size:11.5px;line-height:1.35;padding:5px 9px;border-radius:6px;background:var(--band-2);border:1px solid var(--band-line);color:var(--band-ink);margin-top:3px}
.stat-line b{color:var(--red)}
.tabs{display:flex;gap:5px;flex-wrap:wrap;align-items:center;margin-top:6px}
.tabs a{font-family:var(--f-mono);font-size:11.5px;font-weight:600;text-decoration:none;border:1px solid var(--band-line);padding:5px 10px;border-radius:999px;color:var(--band-ink);background:var(--band-2)}
.tabs a:hover{border-color:var(--red)}
.tabs a[aria-current="page"]{background:var(--red);border-color:var(--red);color:var(--on-red)}
.theme-btn{margin-left:auto;flex:none;width:30px;height:30px;border-radius:999px;border:1px solid var(--band-line);background:var(--band-2);color:var(--band-ink);font-size:14px;line-height:1;display:inline-flex;align-items:center;justify-content:center;padding:0}
@media (max-width:560px){h1{font-size:20px}.cd b{font-size:17px}.logo{width:34px;height:34px}.tabs a{padding:5px 8px;font-size:11px}}
@media (max-width:370px){.tabs a{padding:4px 7px;font-size:10.5px}}

/* ===== sections ===== */
section{display:flex;flex-direction:column;gap:10px;min-width:0}
.head{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:nowrap}
.head h2{flex:1 1 auto;min-width:0;display:flex;align-items:center;flex-wrap:nowrap}
.head h2::after{content:"";flex:none;width:18px;height:3px;background:var(--red);margin-left:8px;border-radius:2px;transform:translateY(1px)}
.head > .note{flex:0 1 auto;max-width:50%;text-align:right;font-size:11.5px;line-height:1.3}
.head.tog{cursor:pointer;user-select:none;-webkit-tap-highlight-color:transparent}
.head.tog h2::before{content:"";flex:none;width:7px;height:7px;border-right:2px solid var(--red);border-bottom:2px solid var(--red);transform:translateY(-2px) rotate(45deg);margin:0 9px 0 2px;transition:transform .15s}
section.closed > .head.tog h2::before{transform:rotate(-45deg)}
.sec-body{display:flex;flex-direction:column;gap:10px;min-width:0}
section.closed > .sec-body{display:none}
.note.clamp{display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden}
.note.clamp.open{display:block;-webkit-line-clamp:unset}
.clampbox{display:flex;gap:8px;align-items:baseline;min-width:0}
.clampbox .note{flex:1;min-width:0}
.more-txt{font-family:var(--f-mono);font-size:11px;font-weight:600;border:0;background:none;color:var(--red-ink);padding:0;white-space:nowrap;flex:none}

/* ===== tiles ===== */
.strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.strip.four{grid-template-columns:repeat(4,minmax(0,1fr))}
@media (max-width:560px){.strip.four{grid-template-columns:repeat(2,minmax(0,1fr))}}
.kpi{background:var(--panel);border:1px solid var(--line);border-radius:7px;padding:7px 10px;min-width:0;position:relative;overflow:hidden}
.kpi::before{content:"";position:absolute;inset:0 0 auto 0;height:2px;background:var(--ink)}
.kpi.hot::before{background:var(--red);height:3px}
.kpi .label{display:block;font-size:9.5px;letter-spacing:.06em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.kpi b{display:block;font-family:var(--f-display);font-weight:600;font-size:19px;line-height:1.15;margin-top:1px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.kpi small{display:block;font-family:var(--f-mono);font-size:10px;color:var(--muted);margin-top:1px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
@media (max-width:560px){.kpi b{font-size:17px}}

/* ===== hero (next race) ===== */
.hero{background:var(--band);color:var(--band-ink);border-radius:10px;padding:12px 14px;display:grid;gap:8px;position:relative;overflow:hidden;border:1px solid var(--band-line)}
.hero::after{content:"";position:absolute;right:-30px;top:0;bottom:0;width:120px;background:repeating-linear-gradient(115deg,transparent 0 14px,rgba(217,20,43,.22) 14px 22px);pointer-events:none}
.hero > *{position:relative;z-index:1}
.hero .label{color:var(--band-muted)}
.hero .label b{color:var(--red);font-weight:600}
.hero h3{font-size:22px;line-height:1.1;text-transform:uppercase;letter-spacing:.02em}
.hero .where{font-size:13px;color:var(--band-muted)}
.hero .big{font-family:var(--f-mono);font-size:30px;font-weight:600;line-height:1;font-variant-numeric:tabular-nums;color:var(--band-ink)}
.hero .big em{font-style:normal;color:var(--red)}
.hero .when{font-family:var(--f-mono);font-size:11.5px;color:var(--band-muted)}
.hero .when b{color:var(--band-ink);font-weight:600}
.hero .tags{display:flex;gap:5px;flex-wrap:wrap}
@media (max-width:440px){.hero .big{font-size:25px}.hero h3{font-size:19px}}
.pill{font-family:var(--f-mono);font-size:9.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:2px 7px;border-radius:4px;white-space:nowrap}
.pill.red{background:var(--red);color:var(--on-red)}
.pill.dim{background:transparent;color:var(--faint);border:1px solid var(--line)}
.pill.done{background:var(--panel-2);color:var(--muted)}
.pill.next{background:var(--ink);color:var(--bg)}
.hero .pill.dim{border-color:var(--band-line);color:var(--band-muted)}

/* ===== lists / rows ===== */
.list{border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--bg)}
.lrow{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center;padding:8px 11px;border-top:1px solid var(--line);font-size:13.5px}
.lrow:first-child{border-top:0}
.lrow .t{font-weight:600;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.lrow .t small{display:block;font-weight:400;font-size:11.5px;color:var(--muted);white-space:normal}
.lrow .r{font-family:var(--f-mono);font-size:12px;text-align:right;white-space:nowrap}
.lrow .r small{display:block;color:var(--faint);font-size:10.5px}
.lrow.is-live{background:var(--red-soft);box-shadow:inset 3px 0 0 var(--red)}
.lrow.is-next{box-shadow:inset 3px 0 0 var(--ink)}
.lrow.is-done{opacity:.62}

/* tap-to-expand bars */
.xbar{display:grid;grid-template-columns:auto minmax(0,1fr) auto 14px;gap:9px;align-items:center;width:100%;padding:9px 11px;border:0;border-top:1px solid var(--line);background:var(--bg);text-align:left;font-size:13.5px}
.list > .xbar:first-child{border-top:0}
.xbar:hover{background:var(--panel)}
.xbar .k{font-family:var(--f-mono);font-size:11px;color:var(--faint);min-width:26px}
.xbar .t{font-weight:600;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.xbar .t small{display:block;font-weight:400;font-size:11.5px;color:var(--muted);overflow:hidden;text-overflow:ellipsis}
.xbar .r{font-family:var(--f-mono);font-size:12px;text-align:right;white-space:nowrap}
.xbar .r small{display:block;font-size:10.5px;color:var(--faint)}
.xbar::after{content:"";width:7px;height:7px;border-right:2px solid var(--red);border-bottom:2px solid var(--red);transform:rotate(-45deg);justify-self:center}
.xbar[aria-expanded="true"]{background:var(--panel);box-shadow:inset 3px 0 0 var(--red)}
.xbar[aria-expanded="true"]::after{transform:translateY(-2px) rotate(45deg)}
.xdetail{border-top:1px solid var(--line);background:var(--panel);padding:10px 11px;display:grid;gap:8px}
.xdetail[hidden]{display:none}

/* tables */
.tbl-wrap{overflow-x:auto;background:var(--bg);border:1px solid var(--line);border-radius:8px}
.xdetail .tbl-wrap{border-radius:6px}
table{border-collapse:collapse;width:100%}
th,td{padding:7px 8px;text-align:right;white-space:nowrap}
th{font-family:var(--f-mono);font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:500;background:var(--panel);border-bottom:1px solid var(--line)}
td{border-bottom:1px solid var(--line);font-size:13.5px}
tr:last-child td{border-bottom:0}
td.n,th.n{font-family:var(--f-mono)}
th.l,td.l{text-align:left}
td.pos{width:34px;font-weight:600;font-family:var(--f-mono)}
td.drv{font-weight:600;max-width:190px;overflow:hidden;text-overflow:ellipsis}
td.drv small{font-weight:400;color:var(--muted);font-size:11.5px;margin-left:5px}
tr.p1 td.pos{color:var(--red);box-shadow:inset 3px 0 0 var(--red)}
tr.champ td{background:var(--red-soft)}
tr.out td{color:var(--faint)}
.dot{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:7px;vertical-align:0;background:var(--faint)}
.gain{color:var(--up);font-family:var(--f-mono)} .loss{color:var(--down);font-family:var(--f-mono)} .flat{color:var(--faint);font-family:var(--f-mono)}
.st{font-family:var(--f-mono);font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase}
.st.leader,.st.champ{color:var(--red)} .st.alive{color:var(--up)} .st.tie{color:var(--gold)} .st.out{color:var(--faint)}
.fl{font-family:var(--f-mono);font-size:9px;font-weight:600;padding:1px 4px;border-radius:3px;background:#6d28d9;color:#fff;margin-left:5px;vertical-align:1px}
.facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px 16px;font-size:13px}
.facts div{display:flex;justify-content:space-between;gap:8px;border-bottom:1px dotted var(--line-strong);padding-bottom:3px;min-width:0}
.facts span{color:var(--muted)}
.facts b{font-family:var(--f-mono);font-weight:600;font-size:12.5px;text-align:right;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
@media (max-width:480px){.facts{grid-template-columns:1fr}}

/* title math */
.tcard{border:1px solid var(--line-strong);border-radius:10px;padding:10px 12px;display:grid;gap:7px;background:linear-gradient(180deg,var(--panel),var(--bg));box-shadow:inset 0 3px 0 var(--red)}
.verdict{font-family:var(--f-display);font-weight:600;font-size:15px;line-height:1.3}
.verdict b{color:var(--red)}
.pv-row{display:grid;grid-template-columns:22px minmax(0,1fr) auto;gap:8px;align-items:center;padding:7px 10px;border-top:1px solid var(--line);font-size:13px}
.pv-row:first-child{border-top:0}
.pv-row .k{font-family:var(--f-mono);font-size:11px;color:var(--faint)}
.pv-row .who{min-width:0;font-weight:600;overflow:hidden;text-overflow:ellipsis}
.pv-row .who small{display:block;font-weight:400;font-size:11.5px;color:var(--muted);white-space:normal}
.pv-row .g{font-family:var(--f-mono);font-size:12px;font-weight:600;text-align:right;white-space:nowrap}
.steps{margin:0;padding:0 0 0 18px;display:grid;gap:4px;font-size:13px}
.steps li::marker{color:var(--red)}

/* teammate battles */
.podium{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}
.pod{border:1px solid var(--line);border-radius:9px;padding:8px 6px;display:grid;gap:2px;background:var(--panel);min-width:0;text-align:center}
.pod.p1{background:var(--band);color:var(--band-ink);border-color:var(--band);box-shadow:inset 0 3px 0 var(--red)}
.pod .medal{font-size:18px;line-height:1}
.pod .who{font-family:var(--f-display);font-weight:600;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pod small{font-family:var(--f-mono);font-size:10px;color:var(--muted);line-height:1.3}
.pod.p1 small{color:var(--band-muted)}
.pod .tag{font-family:var(--f-mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--red)}
.tm-names{display:flex;justify-content:space-between;gap:8px;font-weight:600;font-size:13.5px}
.tm-names span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.duel{display:grid;grid-template-columns:52px minmax(0,1fr);gap:8px;align-items:center}
.duel .label{font-size:9px;letter-spacing:.06em}
.split{display:flex;height:18px;border-radius:4px;overflow:hidden;background:var(--panel-2);font-family:var(--f-mono);font-size:11px;font-weight:600}
.split span{display:flex;align-items:center;padding:0 6px;min-width:0;white-space:nowrap}
.split .a{background:var(--ink);color:var(--bg)}
.split .b{background:var(--red);color:var(--on-red);justify-content:flex-end;margin-left:auto}
.split .a.zero,.split .b.zero{padding:0;width:0}
.tm .xbar{grid-template-columns:minmax(0,1fr) auto 14px}

.sur{display:none}
@media (max-width:560px){.hide-sm{display:none}td.drv small{display:none}.full{display:none}.sur{display:inline}th,td{padding:7px 6px}}
/* live / provisional */
.livebox{border:1px solid var(--red-line);border-radius:10px;padding:10px 12px;display:grid;gap:8px;background:var(--red-soft)}
.livebox h3{font-size:15px;display:flex;align-items:center;gap:8px}
.livebox h3::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--red);animation:ping 1.6s infinite}
.offseason{font-size:14px;padding:12px 14px;border-radius:8px;background:var(--panel);border:1px solid var(--line-strong);box-shadow:inset 3px 0 0 var(--red)}
.empty{font-size:13px;color:var(--muted);padding:10px 12px;border:1px dashed var(--line-strong);border-radius:8px}

/* footer */
footer{display:flex;justify-content:space-between;align-items:center;gap:6px 8px;flex-wrap:wrap;padding-top:12px;border-top:1px solid var(--line);font-family:var(--f-mono);font-size:11px;color:var(--faint);letter-spacing:.03em}
footer .sig{color:var(--muted)} footer .sig b{color:var(--red-ink);font-weight:600}
footer .legal{flex-basis:100%;font-size:10.5px;color:var(--faint);letter-spacing:0;line-height:1.4}
footer a{color:var(--muted)}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head><body>
<div class="band"><header>
  <div class="hdr">
    <div class="brand">
      <img class="logo" src="logo.svg" alt="" width="38" height="38">
      <div><div class="eyebrow" id="eyebrow">F1 Season Tracker <b>//</b> <span id="eb-season"></span></div><h1>Red<span>line</span></h1></div>
    </div>
    <div class="cd" id="cd" hidden><span class="label" id="cd-l">Next</span><b id="cd-t">--:--:--</b><small id="cd-s"></small></div>
  </div>
  <div class="upd num" id="upd"></div>
  <div class="stat-line" id="stat-line" hidden></div>
  <nav class="tabs" aria-label="Pages">
    <a href="index.html" data-p="next">Next Race</a><a href="standings.html" data-p="standings">Standings</a><a href="results.html" data-p="results">Results</a><a href="teammates.html" data-p="teammates">Teammates</a>
    <button class="theme-btn" id="theme-btn" type="button" aria-label="Switch theme">🌙</button>
  </nav>
</header></div>

<div class="wrap">
  <main id="view" style="display:flex;flex-direction:column;gap:20px"></main>
  <footer>
    <span>Data: Jolpica-F1 + OpenF1</span><span class="sig">built by <b>kingtrents</b>⚡️ x claude 🫡</span>
    <span class="legal">Unofficial fan project. Not affiliated with, endorsed by, or connected to Formula 1, the FIA, or any team. F1 and FORMULA 1 are trademarks of Formula One Licensing B.V., used here only to describe the subject. Data from the free <a href="https://github.com/jolpica/jolpica-f1" target="_blank" rel="noopener">Jolpica-F1</a> and <a href="https://openf1.org" target="_blank" rel="noopener">OpenF1</a> projects and may be delayed or wrong.</span>
  </footer>
</div>

<script>
let DATA = __DATA__;
const PAGE = "__PAGE__";
const $ = id => document.getElementById(id);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const TZ = "America/Chicago";
const ct = (d, o) => new Date(d).toLocaleString("en-US", {timeZone: TZ, ...o});
const ctTime = d => ct(d, {hour: "numeric", minute: "2-digit"}) + " CT";
const ctDay = d => ct(d, {weekday: "short", month: "short", day: "numeric"});
const pts = p => (p == null ? "" : (Number.isInteger(+p) ? String(+p) : (+p).toFixed(1)));
const short = n => String(n || "").replace(" Grand Prix", " GP");
const pad = n => String(n).padStart(2, "0");
const SESS_SHORT = {"Practice 1": "FP1", "Practice 2": "FP2", "Practice 3": "FP3", "Sprint Qualifying": "Sprint Quali", "Sprint": "Sprint", "Qualifying": "Qualifying", "Race": "Race"};
function color(row){
  const c = DATA.colors || {};
  return c[String(row?.num)] || null;
}
function teamColor(teamId){
  for (const r of (DATA.standings?.drivers || [])) if (r.teamId === teamId && color(r)) return color(r);
  return null;
}
const dot = c => `<i class="dot" style="${c ? "background:" + esc(c) : ""}"></i>`;
function dur(ms){
  const s = Math.max(0, Math.floor(ms / 1000)), d = Math.floor(s / 86400), h = Math.floor(s % 86400 / 3600), m = Math.floor(s % 3600 / 60), x = s % 60;
  return d ? `${d}d ${h}h ${pad(m)}m` : `${h}:${pad(m)}:${pad(x)}`;
}
function trackTime(iso){
  const off = DATA.meeting?.gmt_offset; if (!off) return "";
  const m = off.match(/^(-?)(\d+):(\d+)/); if (!m) return "";
  const mins = (m[1] ? -1 : 1) * (+m[2] * 60 + +m[3]);
  const d = new Date(new Date(iso).getTime() + mins * 60000);
  return d.toLocaleString("en-US", {timeZone: "UTC", weekday: "short", hour: "numeric", minute: "2-digit"});
}
function sessState(s, now = Date.now()){
  const a = new Date(s.start).getTime(), b = new Date(s.end).getTime();
  return now >= b ? "done" : now >= a ? "live" : "upcoming";
}
function nextSession(){
  const n = DATA.next; if (!n) return null;
  const now = Date.now();
  const live = n.sessions.find(s => sessState(s, now) === "live");
  if (live) return {s: live, live: true};
  const up = n.sessions.find(s => sessState(s, now) === "upcoming");
  return up ? {s: up, live: false} : null;
}

